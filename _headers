# Netlify response headers (Nov 5 2026).
# Fonts never change in place (a new cut of a font gets a new file name), so
# browsers keep them a year instead of revalidating them on every load. With
# app.html's font-display: block, that keeps text from waiting on a round trip.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
